<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Profile</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f2f2f2;
            color: #333;
        }

        header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 30px;
        }

        nav {
            background-color: #34495e;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 20px;
        }

        nav a:hover {
            color: #f1c40f;
        }

        section {
            max-width: 900px;
            margin: 25px auto;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
        }

        article {
            padding: 15px;
            margin-top: 10px;
            background-color: #ecf0f1;
            border-radius: 8px;
        }

        footer {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>My Personal Profile</h1>
        <p>Welcome to my profile webpage</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- About Section -->
    <section id="about">
        <h2>About Me</h2>

        <article>
            <h3>Personal Information</h3>
            <p>
                Hello! My name is Saurav Kumar. I am a Computer Science
                student interested in programming, web development and
                technology.
            </p>
        </article>
    </section>

    <!-- Education Section -->
    <section id="education">
        <h2>Education</h2>

        <article>
            <h3>B.Tech in Computer Science</h3>
            <p>
                I am pursuing my Bachelor of Technology in Computer Science
                and Engineering.
            </p>
        </article>
    </section>

    <!-- Skills Section -->
    <section id="skills">
        <h2>My Skills</h2>

        <article>
            <h3>Technical Skills</h3>
            <ul>
                <li>HTML5</li>
                <li>CSS</li>
                <li>C / C++</li>
                <li>Data Structures</li>
                <li>Web Development</li>
            </ul>
        </article>
    </section>

    <!-- Contact Section -->
    <section id="contact">
        <h2>Contact Me</h2>

        <article>
            <p>Email: example@gmail.com</p>
            <p>Phone: +91-XXXXXXXXXX</p>
        </article>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 My Personal Profile. All Rights Reserved.</p>
    </footer>

</body>
</html>
